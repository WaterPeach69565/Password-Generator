import string, random
from random import choice

def Random_letter():
    L = random.choice(string.ascii_letters)
    return L


def Random_number():
    N = random.randint(0, 9)
    return N


New_Password = []
iteration = 0

while iteration < 13:
    fns = [Random_letter, Random_number]
    FC = choice(fns)()
    New_Password.append(FC)
    iteration += 1

Final_Password = ''.join(map(str,New_Password))

print(Final_Password)
